# Optional Vite / shell env (copy to .env.local)
# VITE_ALLOWED_HOSTS=true
# VITE_ALLOWED_HOSTS=hermes.example.com
# VITE_DESKTOP_URL=https://your-novnc.example
# HERMES_HOME=
# HERMES_BIN=
# Optional server-side access password (12+ characters).
# If omitted, a random password is saved to ~/.hermes-web-shell/access-password.txt.
# Browser login uses a password form and a persistent session cookie.
# SHELL_ACCESS_PASSWORD=

# Public HTTPS address used by phone pairing QR codes.
# SHELL_PUBLIC_URL=https://hermes.example.com
